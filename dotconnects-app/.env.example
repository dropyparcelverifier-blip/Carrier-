# Supabase — same project as the Next.js app.
#
# NOT PUBLIC_SUPABASE_URL. SvelteKit's $env/dynamic/private deliberately
# excludes anything prefixed PUBLIC_, so that name reads as undefined on
# the server and every lookup silently falls back to demo data.
#
# This app has no browser-side Supabase client — all queries go through
# API routes with the service-role key — so nothing here needs to be
# public.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin session cookie signing key. Any long random string.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Shared secret Order Central sends in x-bridge-secret
ORDER_CENTRAL_BRIDGE_SECRET=

# Courier webhook secrets
SHIPROCKET_WEBHOOK_SECRET=
VELOCITY_WEBHOOK_SECRET=

# Courier APIs (M8)
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
VELOCITY_API_TOKEN=

# Shopify write-back (M8)
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
