# ── Supabase (server only — never exposed to the browser) ──
# Settings → API in your Supabase dashboard.
# Use the SERVICE ROLE key here, not the anon key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Session signing secret ──
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Where the tracking app lives. Tracking and admin are a separate
# SvelteKit app now — this site is marketing only.
NEXT_PUBLIC_TRACKING_ORIGIN=https://track.dotconnectslogistics.com
