# Copy to .env.local for local dev, or set as project environment
# variables on your host (e.g. Vercel → Project → Settings →
# Environment Variables). Never commit real values — this file only
# documents which variables the app reads and what they're for.

# ── Supabase ──────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — server-only, never exposed to the browser. Required
# for the admin panel and /api/track to work; RLS denies the anon key
# entirely (see supabase/schema.sql section 6).
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin login ───────────────────────────────────────────────────
# Dev-only fallback used when Supabase isn't configured at all — the real
# admin account lives in the admin_users table (supabase/schema.sql),
# seeded with username "admin" / password "dropy@admin2026" by default.
# Change that seeded password before this goes in front of a customer.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Signs the admin session cookie — any long random string.
ADMIN_SESSION_SECRET=

# ── Order Central bridge ─────────────────────────────────────────
# Shared secret Order Central sends in the x-bridge-secret header when
# calling app/api/admin/orders/from-order-central/* — must match exactly
# on both sides.
ORDER_CENTRAL_BRIDGE_SECRET=

# ── Last-mile courier webhooks ───────────────────────────────────
# See app/api/webhooks/shiprocket and .../velocity, and lib/last-mile.ts.
# Generate any random string for each; Shiprocket's is entered in their
# dashboard under Settings → API → Webhook. Velocity's is provided by
# their onboarding team (no self-serve dashboard as of this writing).
SHIPROCKET_WEBHOOK_SECRET=
VELOCITY_WEBHOOK_SECRET=
